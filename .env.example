# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG EVENTTICK (.env)
# ==========================================

# 1. KẾT NỐI CƠ SỞ DỮ LIỆU (DATABASE_URL)
# Mặc định sử dụng PostgreSQL (Local hoặc Docker):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventtick_db

# Khi triển khai trong mạng Docker Compose (service app gọi service db):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/eventtick_db

# Chế độ chạy SQLite cục bộ độc lập (không cần cài đặt DB server):
# DATABASE_URL=sqlite:///./eventtick.db

# 2. CẤU HÌNH DOCKER POSTGRESQL (service db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventtick_db
POSTGRES_PORT=5432

# 3. CẤU HÌNH MÁY CHỦ FASTAPI
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
JWT_SECRET=supersecret_jwt_key_eventtick_2026
