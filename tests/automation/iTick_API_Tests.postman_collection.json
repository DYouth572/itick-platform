          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"event_id\": 1, \"tier_id\": 1, \"quantity\": 1, \"payment_method\": \"WALLET\"}"
